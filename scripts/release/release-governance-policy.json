{
  "schemaVersion": "release_governance_v1",
  "updatedAt": "2026-04-08",
  "versioningStrategy": {
    "lockstep": ["core-*", "adapter-sdk", "shared"],
    "independent": ["adapters/*", "memory-providers/*", "notification-providers/*"]
  },
  "channels": [
    {
      "name": "canary",
      "requiredChecks": ["pnpm run release:check", "pnpm run test:contract"],
      "promotionCriteria": ["core contract matrix stable", "no block-level release issues"]
    },
    {
      "name": "rc",
      "requiredChecks": ["pnpm run release:candidate"],
      "promotionCriteria": ["ci quality baseline green", "local distribution verification passed"]
    },
    {
      "name": "ga",
      "requiredChecks": ["pnpm run release:ga-check"],
      "promotionCriteria": [
        "release candidate checks green",
        "rollback playbook available",
        "stage9 blackbox ga baseline report available"
      ]
    }
  ],
  "rollbackTriggers": [
    "critical production regression detected",
    "release gate violation after channel promotion",
    "incompatible contract change in lockstep group"
  ],
  "minimumAuditEvidence": [
    "release_check_report",
    "host_distribution_verify_result",
    "vscode_extension_distribution_verify_result",
    "distribution_verify_result",
    "channel_promotion_record",
    "stage9_blackbox_ga_report"
  ],
  "auditEvidenceSources": {
    "host_distribution_verify_result": {
      "sourceType": "report_file",
      "reportPath": ".tmp/release-host-distribution-validation-report.json",
      "requiredStatus": "pass"
    },
    "vscode_extension_distribution_verify_result": {
      "sourceType": "report_file",
      "reportPath": ".tmp/release-vscode-extension-distribution-report.json",
      "requiredStatus": "pass"
    },
    "stage9_blackbox_ga_report": {
      "sourceType": "report_file",
      "reportPath": ".tmp/ci/stage9-blackbox-ga/stage9-blackbox-ga-report.json",
      "requiredStatus": "passed"
    }
  },
  "rollbackRehearsal": {
    "entryCommand": "pnpm run release:rollback-rehearsal",
    "reportPath": ".tmp/ci/release/rollback-rehearsal-report.json",
    "scenarios": [
      "critical-production-regression",
      "post-promotion-gate-violation",
      "lockstep-contract-incompatibility"
    ]
  },
  "gaCandidateUnifiedGate": {
    "entryCommand": "pnpm run release:ga-candidate-unified-gate",
    "reportPath": ".tmp/ci/release/ga-candidate-unified-gate-report.json",
    "requiredCheckGroups": [
      "contract-baseline",
      "resilience-regression",
      "integration-regression",
      "e2e-regression",
      "release-ga-check",
      "rollback-rehearsal",
      "governance-gate"
    ]
  }
}
