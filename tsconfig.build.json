{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": ".",
    "sourceMap": true
  },
  "include": ["apps/**/*", "packages/**/*", "bin/**/*"],
  "exclude": ["node_modules", "dist", "test/**/*", "scripts/**/*", "**/*.test.*"]
}
