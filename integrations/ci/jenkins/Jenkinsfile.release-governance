pipeline {
  agent any

  options {
    timeout(time: 90, unit: 'MINUTES')
  }

  parameters {
    choice(name: 'RELEASE_CHANNEL', choices: ['canary', 'rc', 'ga'], description: 'Release channel to validate')
    booleanParam(name: 'RUN_ROLLBACK_ON_FAILURE', defaultValue: true, description: 'Run rollback rehearsal automatically when GA validation fails')
  }

  environment {
    STAGE9_HANDOFF_PATH = '.repo-ai-governor/context/dev/project-009-production-readiness/sprint-001-local-adoption-and-install-readiness/tasks/TK-080-sprint-001-exit-acceptance-and-sprint-002-input-constraints.md'
    CI_RELEASE_REPORT_ROOT = '.tmp/ci/release'
    GA_UNIFIED_GATE_REPORT = '.tmp/ci/release/ga-candidate-unified-gate-report.json'
    ROLLBACK_REHEARSAL_REPORT = '.tmp/ci/release/rollback-rehearsal-report.json'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Install') {
      steps {
        sh 'corepack enable'
        sh 'corepack prepare pnpm@10.30.3 --activate'
        sh 'pnpm install --frozen-lockfile'
      }
    }

    stage('Stage9 Handoff') {
      steps {
        sh 'pnpm run check:stage9-handoff'
      }
    }

    stage('Release Governance') {
      steps {
        script {
          sh 'mkdir -p "${CI_RELEASE_REPORT_ROOT}"'

          String command
          if (params.RELEASE_CHANNEL == 'canary') {
            command = 'pnpm run release:check && pnpm run test:contract -- --maxWorkers=1 --maxConcurrency=1'
          } else if (params.RELEASE_CHANNEL == 'rc') {
            command = 'pnpm run release:candidate'
          } else {
            command = 'pnpm run release:ga-candidate-unified-gate -- --output "${GA_UNIFIED_GATE_REPORT}"'
          }

          int releaseExitCode = sh(script: "bash -lc '${command}'", returnStatus: true)
          Integer rollbackExitCode = null

          if (params.RELEASE_CHANNEL == 'ga' && releaseExitCode != 0 && params.RUN_ROLLBACK_ON_FAILURE) {
            rollbackExitCode = sh(
              script: 'pnpm run release:rollback-rehearsal -- --output "${ROLLBACK_REHEARSAL_REPORT}"',
              returnStatus: true,
            )
          }

          withEnv([
            "RELEASE_COMMAND=${command}",
            "RELEASE_EXIT_CODE=${releaseExitCode}",
            "ROLLBACK_EXIT_CODE=${rollbackExitCode == null ? '' : rollbackExitCode}",
          ]) {
            sh '''
              node -e '
                const fs = require("node:fs");
                const path = require("node:path");
                const root = process.env.CI_RELEASE_REPORT_ROOT;
                fs.mkdirSync(root, { recursive: true });
                const payload = {
                  reportType: "release_governance_jenkins_summary_v1",
                  generatedAt: new Date().toISOString(),
                  releaseChannel: process.env.RELEASE_CHANNEL,
                  releaseCommand: process.env.RELEASE_COMMAND,
                  releaseExitCode: Number(process.env.RELEASE_EXIT_CODE),
                  rollbackExitCode:
                    typeof process.env.ROLLBACK_EXIT_CODE === "string" &&
                    process.env.ROLLBACK_EXIT_CODE.length > 0
                      ? Number(process.env.ROLLBACK_EXIT_CODE)
                      : null,
                  reports: {
                    gaUnifiedGateReport: process.env.GA_UNIFIED_GATE_REPORT,
                    rollbackRehearsalReport: process.env.ROLLBACK_REHEARSAL_REPORT,
                  },
                };
                fs.writeFileSync(
                  path.join(root, "release-channel-summary.json"),
                  `${JSON.stringify(payload, null, 2)}\\n`,
                  "utf8",
                );
              '
            '''
          }

          if (releaseExitCode != 0) {
            error("release channel command failed: ${releaseExitCode}")
          }
          if (rollbackExitCode != null && rollbackExitCode != 0) {
            error("rollback rehearsal failed: ${rollbackExitCode}")
          }
        }
      }
      post {
        always {
          archiveArtifacts artifacts: '.tmp/ci/release/*.json', allowEmptyArchive: true
        }
      }
    }
  }
}
