{
  "name": "@cjhdev/repo-ai-governor",
  "version": "0.1.5",
  "private": false,
  "description": "Repository-local AI governance CLI.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/JimmyDaddy/repo-ai-governor.git"
  },
  "bugs": {
    "url": "https://github.com/JimmyDaddy/repo-ai-governor/issues"
  },
  "homepage": "https://github.com/JimmyDaddy/repo-ai-governor",
  "bin": {
    "repo-ai-governor": "./bin/repo-ai-governor.js"
  },
  "files": [
    "bin",
    "src",
    "skills",
    "scripts/examples"
  ],
  "scripts": {
    "start": "node ./bin/repo-ai-governor.js",
    "help": "node ./bin/repo-ai-governor.js --help",
    "test": "node --test",
    "check:imports": "node ./scripts/governance/check-esm-import-specifiers.js",
    "check:code-standards": "node ./scripts/governance/check-code-standards.js --standards code_standards.md",
    "check": "npm run check:code-standards",
    "smoke:automation": "bash ./scripts/ci/run-automation-smoke.sh",
    "release": "release-it",
    "release:dry-run": "release-it --dry-run",
    "release:check": "node ./scripts/release/check-release-ready.js",
    "release:notes": "node ./scripts/release/render-release-notes.js",
    "release:verify-local": "node ./scripts/release/verify-local-distribution.js",
    "release:candidate": "npm run check && npm run release:check && npm run release:verify-local",
    "release:ga-check": "npm run release:candidate",
    "release:pack": "npm pack --json"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "commander": "^13.1.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^9.0.4",
    "release-it": "^17.11.0"
  }
}
