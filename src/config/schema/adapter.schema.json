{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repo-ai-governor.dev/schemas/v1/adapter.schema.json",
  "title": "Repo AI Governor Adapter Schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "type"],
  "properties": {
    "id": {
      "$ref": "./shared.schema.json#/$defs/adapterId"
    },
    "version": {
      "type": "string",
      "const": "1"
    },
    "type": {
      "type": "string",
      "enum": ["ide", "cli", "ide-or-cli", "agent", "ci"]
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "meta": {
      "$ref": "#/$defs/metaConfig",
      "default": {}
    },
    "targets": {
      "$ref": "#/$defs/targetsConfig",
      "default": {
        "products": [],
        "entrypoints": [],
        "protocols": []
      }
    },
    "capabilities": {
      "$ref": "#/$defs/capabilitiesConfig",
      "default": {
        "promptInjection": true,
        "structuredOutput": true,
        "toolCalling": true,
        "fileSystemAccess": false,
        "terminalAccess": false,
        "patchEditing": false,
        "approvalControl": false
      }
    },
    "contract": {
      "$ref": "#/$defs/contractConfig",
      "default": {
        "input": {
          "sources": ["workflow", "standards", "slots"],
          "requiredViews": ["ai"],
          "supportedFormats": ["markdown", "json"]
        },
        "output": {
          "artifactKinds": ["plan", "check-report", "review-report", "task-record"],
          "supportedFormats": ["markdown", "json", "text"],
          "supportsReviewLifecycle": true
        }
      }
    },
    "injection": {
      "$ref": "#/$defs/injectionConfig",
      "default": {
        "mode": "file-and-template",
        "sources": ["standards", "workflow", "slots"],
        "promptSections": ["workflow", "standards", "slots"],
        "templateVariables": []
      }
    },
    "render": {
      "$ref": "#/$defs/renderConfig",
      "default": {
        "locale": "zh-CN",
        "views": ["ai"],
        "fileNameTemplate": ""
      }
    },
    "policy": {
      "$ref": "#/$defs/policyConfig",
      "default": {
        "strictWorkflow": true,
        "nonInteractiveSafe": true,
        "allowAutonomousExecution": false,
        "requiresApprovalFor": []
      }
    }
  },
  "$defs": {
    "metaConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "./shared.schema.json#/$defs/localizedText"
        },
        "provider": {
          "$ref": "./shared.schema.json#/$defs/nonEmptyString"
        },
        "description": {
          "$ref": "./shared.schema.json#/$defs/localizedText"
        }
      }
    },
    "targetsConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "products": {
          "$ref": "./shared.schema.json#/$defs/stringList",
          "default": []
        },
        "entrypoints": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["ide", "cli", "agent", "ci"]
          },
          "uniqueItems": true,
          "default": []
        },
        "protocols": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["file", "template", "prompt", "command", "agent-entry"]
          },
          "uniqueItems": true,
          "default": []
        }
      }
    },
    "capabilitiesConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "promptInjection": {
          "type": "boolean",
          "default": true
        },
        "structuredOutput": {
          "type": "boolean",
          "default": true
        },
        "toolCalling": {
          "type": "boolean",
          "default": true
        },
        "fileSystemAccess": {
          "type": "boolean",
          "default": false
        },
        "terminalAccess": {
          "type": "boolean",
          "default": false
        },
        "patchEditing": {
          "type": "boolean",
          "default": false
        },
        "approvalControl": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "contractEndpointConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["workflow", "standards", "slots", "agent-entry", "artifacts", "runtime-context"]
          },
          "uniqueItems": true,
          "default": []
        },
        "requiredViews": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["ai", "human"]
          },
          "uniqueItems": true,
          "default": []
        },
        "supportedFormats": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["markdown", "json", "yaml", "text"]
          },
          "uniqueItems": true,
          "default": []
        }
      }
    },
    "contractOutputConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifactKinds": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["plan", "check-report", "review-report", "task-record", "summary", "agent-entry"]
          },
          "uniqueItems": true,
          "default": []
        },
        "supportedFormats": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["markdown", "json", "yaml", "text"]
          },
          "uniqueItems": true,
          "default": []
        },
        "supportsReviewLifecycle": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "contractConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input": {
          "$ref": "#/$defs/contractEndpointConfig",
          "default": {
            "sources": ["workflow", "standards", "slots"],
            "requiredViews": ["ai"],
            "supportedFormats": ["markdown", "json"]
          }
        },
        "output": {
          "$ref": "#/$defs/contractOutputConfig",
          "default": {
            "artifactKinds": ["plan", "check-report", "review-report", "task-record"],
            "supportedFormats": ["markdown", "json", "text"],
            "supportsReviewLifecycle": true
          }
        }
      }
    },
    "injectionConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["file", "template", "file-and-template", "direct-prompt"],
          "default": "file-and-template"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["standards", "workflow", "slots", "agent-entry", "artifacts"]
          },
          "uniqueItems": true,
          "default": ["standards", "workflow", "slots"]
        },
        "promptSections": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["workflow", "standards", "slots", "agent-entry", "artifacts"]
          },
          "uniqueItems": true,
          "default": ["workflow", "standards", "slots"]
        },
        "templateVariables": {
          "$ref": "./shared.schema.json#/$defs/stringList",
          "default": []
        }
      }
    },
    "renderConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "locale": {
          "$ref": "./shared.schema.json#/$defs/localeCode",
          "default": "zh-CN"
        },
        "views": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["ai", "human"]
          },
          "uniqueItems": true,
          "default": ["ai"]
        },
        "fileNameTemplate": {
          "type": "string",
          "default": ""
        }
      }
    },
    "policyConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strictWorkflow": {
          "type": "boolean",
          "default": true
        },
        "nonInteractiveSafe": {
          "type": "boolean",
          "default": true
        },
        "allowAutonomousExecution": {
          "type": "boolean",
          "default": false
        },
        "requiresApprovalFor": {
          "$ref": "./shared.schema.json#/$defs/stringList",
          "default": []
        }
      }
    }
  }
}
