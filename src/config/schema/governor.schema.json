{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repo-ai-governor.dev/schemas/v1/governor.schema.json",
  "title": "Repo AI Governor Main Configuration Schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1",
      "default": "1"
    },
    "project": {
      "$ref": "#/$defs/projectConfig",
      "default": {
        "language": "typescript",
        "framework": "node",
        "packageManager": "npm",
        "rootDir": "."
      }
    },
    "workflow": {
      "$ref": "#/$defs/workflowConfig",
      "default": {
        "template": "standard",
        "stages": [],
        "allowSkipStages": false,
        "stopOnFailure": true,
        "requireHumanApprovalFor": []
      }
    },
    "standards": {
      "$ref": "#/$defs/standardsConfig",
      "default": {
        "preset": "official/base",
        "overrides": {},
        "locales": {
          "default": "zh-CN",
          "supported": ["zh-CN", "en-US"]
        },
        "render": {
          "aiView": true,
          "humanView": true
        }
      }
    },
    "slots": {
      "$ref": "#/$defs/slotsConfig",
      "default": {
        "enabled": [],
        "disabled": [],
        "directory": ".repo-ai-governor/slots",
        "conflictPolicy": "error"
      }
    },
    "adapters": {
      "$ref": "#/$defs/adaptersConfig",
      "default": {
        "enabled": [],
        "directory": ".repo-ai-governor/adapters",
        "defaults": {},
        "strictMode": false
      }
    },
    "execution": {
      "$ref": "#/$defs/executionConfig",
      "default": {
        "taskPrefix": "TK"
      }
    },
    "automation": {
      "$ref": "#/$defs/automationConfig",
      "default": {
        "mode": "assisted",
        "defaultSurface": "codex",
        "routingProfile": "multi-ai-dev-review",
        "routing": {},
        "profiles": {},
        "preflight": {
          "enabled": true,
          "failOnMissingRequiredSurface": true
        },
        "surfaces": {},
        "taskLoop": {
          "maxReviewCycles": 3,
          "completionStatuses": ["done", "resolved", "completed", "closed"]
        },
        "process": {
          "stageDefinitions": [],
          "draftReviewLoop": {
            "enabled": true,
            "routeSequence": ["draft-review", "draft-review-verify"],
            "maxReviewCycles": 2,
            "completionPolicy": "first-cycle"
          },
          "solutionReviewLoop": {
            "enabled": true,
            "routeSequence": [
              "technical-solution",
              "technical-solution-review",
              "technical-solution-revise"
            ],
            "maxReviewCycles": 3,
            "completionPolicy": "first-cycle"
          },
          "taskLoop": {
            "stageId": "task-delivery-loop",
            "implementationRouteKey": "task-implementation",
            "codeReviewRouteKey": "task-code-review",
            "maxReviewCycles": 3
          }
        },
        "permissions": {
          "allowRead": true,
          "allowEditCode": true,
          "allowEditDocs": true,
          "allowRunChecks": true,
          "allowCommit": true,
          "allowPush": true,
          "allowPullRequest": true,
          "allowSecretsEdit": false,
          "allowInfraEdit": false,
          "allowProductionConfigEdit": false,
          "allowDangerousCommands": false
        },
        "gates": {
          "requireApprovalFor": []
        },
        "audit": {
          "enabled": true,
          "logPrompts": false,
          "logCommands": true,
          "outputDir": ".repo-ai-governor/reports/runs",
          "latestFileName": "latest-run.json"
        }
      }
    },
    "ci": {
      "$ref": "#/$defs/ciConfig",
      "default": {
        "enabled": true,
        "commandProfile": "default",
        "failOn": ["errors"],
        "writeJsonReport": true,
        "writeMarkdownReport": false
      }
    },
    "reporting": {
      "$ref": "#/$defs/reportingConfig",
      "default": {
        "outputDir": ".repo-ai-governor/reports",
        "formats": ["summary", "markdown", "json"],
        "overwrite": false,
        "includeSummary": true,
        "fileNames": {
          "summary": "latest.txt",
          "markdown": "latest.md",
          "json": "latest.json"
        }
      }
    },
    "artifacts": {
      "$ref": "#/$defs/artifactsConfig",
      "default": {
        "baseDir": "docs",
        "structure": "project-sprint",
        "files": {
          "index": "index.md",
          "plan": "plan.md"
        },
        "directories": {
          "tasks": "tasks",
          "codeReview": "code-review"
        },
        "taskFiles": {
          "checklist": "checklist.md",
          "csv": "tasks.csv",
          "csvColumns": [
            "execution_id",
            "task_id",
            "title",
            "owner",
            "priority",
            "due_date",
            "status",
            "project",
            "sprint",
            "plan",
            "result",
            "verify",
            "review_delta",
            "recorded_at"
          ]
        },
        "reviewFiles": {
          "pending": "review_<slug>.md",
          "verified": "verified_review_<slug>.md",
          "resolved": "resolved_review_<slug>.md"
        }
      }
    },
    "agentEntry": {
      "$ref": "#/$defs/agentEntryConfig",
      "default": {
        "target": "AGENTS.md",
        "contextFile": ".repo-ai-governor/context/current-context.md",
        "mode": "generated-from-structured-config",
        "includeSections": [
          "current-context",
          "source-of-truth",
          "working-rules",
          "naming-rules",
          "default-workflow",
          "local-skills"
        ]
      }
    }
  },
  "$defs": {
    "projectConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "./shared.schema.json#/$defs/nonEmptyString"
        },
        "language": {
          "type": "string",
          "default": "typescript"
        },
        "framework": {
          "type": "string",
          "default": "node"
        },
        "packageManager": {
          "type": "string",
          "default": "npm"
        },
        "rootDir": {
          "$ref": "./shared.schema.json#/$defs/relativePath",
          "default": "."
        }
      }
    },
    "workflowStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {
          "$ref": "./shared.schema.json#/$defs/stageId"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "required": {
          "type": "boolean",
          "default": true
        },
        "onFailure": {
          "$ref": "./shared.schema.json#/$defs/failurePolicy",
          "default": "stop"
        },
        "requiresApproval": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "workflowConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "template": {
          "type": "string",
          "default": "standard"
        },
        "stages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/workflowStage"
          },
          "default": []
        },
        "allowSkipStages": {
          "type": "boolean",
          "default": false
        },
        "stopOnFailure": {
          "type": "boolean",
          "default": true
        },
        "requireHumanApprovalFor": {
          "$ref": "./shared.schema.json#/$defs/stringList",
          "default": []
        }
      }
    },
    "standardsLocales": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": {
          "$ref": "./shared.schema.json#/$defs/localeCode",
          "default": "zh-CN"
        },
        "supported": {
          "$ref": "./shared.schema.json#/$defs/localeList",
          "default": ["zh-CN", "en-US"]
        }
      }
    },
    "standardsRender": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "aiView": {
          "type": "boolean",
          "default": true
        },
        "humanView": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "standardsConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preset": {
          "type": "string",
          "default": "official/base"
        },
        "overrides": {
          "$ref": "./shared.schema.json#/$defs/jsonObject",
          "default": {}
        },
        "locales": {
          "$ref": "#/$defs/standardsLocales",
          "default": {
            "default": "zh-CN",
            "supported": ["zh-CN", "en-US"]
          }
        },
        "render": {
          "$ref": "#/$defs/standardsRender",
          "default": {
            "aiView": true,
            "humanView": true
          }
        }
      }
    },
    "slotsConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "$ref": "./shared.schema.json#/$defs/slugList",
          "default": []
        },
        "disabled": {
          "$ref": "./shared.schema.json#/$defs/slugList",
          "default": []
        },
        "directory": {
          "$ref": "./shared.schema.json#/$defs/relativePath",
          "default": ".repo-ai-governor/slots"
        },
        "conflictPolicy": {
          "type": "string",
          "enum": ["error", "merge", "replace"],
          "default": "error"
        }
      }
    },
    "adaptersConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "$ref": "./shared.schema.json#/$defs/slugList",
          "default": []
        },
        "directory": {
          "$ref": "./shared.schema.json#/$defs/relativePath",
          "default": ".repo-ai-governor/adapters"
        },
        "defaults": {
          "$ref": "./shared.schema.json#/$defs/jsonObject",
          "default": {}
        },
        "strictMode": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "executionConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "currentProject": {
          "$ref": "./shared.schema.json#/$defs/projectSlug"
        },
        "currentSprint": {
          "$ref": "./shared.schema.json#/$defs/sprintName"
        },
        "taskPrefix": {
          "$ref": "./shared.schema.json#/$defs/taskPrefix",
          "default": "TK"
        },
        "defaultOwner": {
          "$ref": "./shared.schema.json#/$defs/nonEmptyString"
        }
      }
    },
    "automationPermissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowRead": {
          "type": "boolean",
          "default": true
        },
        "allowEditCode": {
          "type": "boolean",
          "default": true
        },
        "allowEditDocs": {
          "type": "boolean",
          "default": true
        },
        "allowRunChecks": {
          "type": "boolean",
          "default": true
        },
        "allowCommit": {
          "type": "boolean",
          "default": true
        },
        "allowPush": {
          "type": "boolean",
          "default": true
        },
        "allowPullRequest": {
          "type": "boolean",
          "default": true
        },
        "allowSecretsEdit": {
          "type": "boolean",
          "default": false
        },
        "allowInfraEdit": {
          "type": "boolean",
          "default": false
        },
        "allowProductionConfigEdit": {
          "type": "boolean",
          "default": false
        },
        "allowDangerousCommands": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "automationGates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requireApprovalFor": {
          "$ref": "./shared.schema.json#/$defs/stringList",
          "default": []
        }
      }
    },
    "automationSurfaceId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "automationStageRouting": {
      "type": "object",
      "propertyNames": {
        "$ref": "./shared.schema.json#/$defs/stageId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/automationSurfaceId"
      },
      "default": {}
    },
    "automationRoutingProfile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultSurface": {
          "$ref": "#/$defs/automationSurfaceId"
        },
        "routing": {
          "$ref": "#/$defs/automationStageRouting",
          "default": {}
        }
      },
      "default": {
        "routing": {}
      }
    },
    "automationPreflight": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "failOnMissingRequiredSurface": {
          "type": "boolean",
          "default": true
        }
      },
      "default": {
        "enabled": true,
        "failOnMissingRequiredSurface": true
      }
    },
    "automationSurfaceProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binary"],
      "properties": {
        "binary": {
          "$ref": "./shared.schema.json#/$defs/nonEmptyString"
        },
        "binaryArgs": {
          "$ref": "./shared.schema.json#/$defs/stringList",
          "default": ["--version"]
        },
        "healthArgs": {
          "$ref": "./shared.schema.json#/$defs/stringList",
          "default": ["--help"]
        },
        "workspaceDir": {
          "$ref": "./shared.schema.json#/$defs/relativePath"
        }
      }
    },
    "automationSurfaces": {
      "type": "object",
      "propertyNames": {
        "$ref": "./shared.schema.json#/$defs/slug"
      },
      "additionalProperties": {
        "$ref": "#/$defs/automationSurfaceProbe"
      },
      "default": {}
    },
    "automationTaskLoop": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxReviewCycles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 3
        },
        "completionStatuses": {
          "$ref": "./shared.schema.json#/$defs/stringList",
          "default": ["done", "resolved", "completed", "closed"]
        }
      },
      "default": {
        "maxReviewCycles": 3,
        "completionStatuses": ["done", "resolved", "completed", "closed"]
      }
    },
    "automationProcessStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {
          "$ref": "./shared.schema.json#/$defs/stageId"
        },
        "kind": {
          "type": "string",
          "enum": ["system", "ai", "human", "loop"],
          "default": "ai"
        },
        "requiredSurface": {
          "type": "boolean"
        },
        "routeKey": {
          "$ref": "./shared.schema.json#/$defs/nonEmptyString"
        },
        "name": {
          "$ref": "./shared.schema.json#/$defs/localizedText"
        }
      }
    },
    "automationProcessTaskLoop": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stageId": {
          "$ref": "./shared.schema.json#/$defs/stageId",
          "default": "task-delivery-loop"
        },
        "implementationRouteKey": {
          "$ref": "./shared.schema.json#/$defs/nonEmptyString",
          "default": "task-implementation"
        },
        "codeReviewRouteKey": {
          "$ref": "./shared.schema.json#/$defs/nonEmptyString",
          "default": "task-code-review"
        },
        "maxReviewCycles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 3
        }
      },
      "default": {
        "stageId": "task-delivery-loop",
        "implementationRouteKey": "task-implementation",
        "codeReviewRouteKey": "task-code-review",
        "maxReviewCycles": 3
      }
    },
    "automationProcessReviewLoop": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "routeSequence": {
          "$ref": "./shared.schema.json#/$defs/stringList",
          "default": []
        },
        "maxReviewCycles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 3
        },
        "completionPolicy": {
          "type": "string",
          "enum": ["first-cycle", "max-cycles"],
          "default": "first-cycle"
        }
      },
      "default": {
        "enabled": true,
        "routeSequence": [],
        "maxReviewCycles": 3,
        "completionPolicy": "first-cycle"
      }
    },
    "automationProcess": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stageDefinitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/automationProcessStage"
          },
          "default": []
        },
        "draftReviewLoop": {
          "$ref": "#/$defs/automationProcessReviewLoop",
          "default": {
            "enabled": true,
            "routeSequence": ["draft-review", "draft-review-verify"],
            "maxReviewCycles": 2,
            "completionPolicy": "first-cycle"
          }
        },
        "solutionReviewLoop": {
          "$ref": "#/$defs/automationProcessReviewLoop",
          "default": {
            "enabled": true,
            "routeSequence": [
              "technical-solution",
              "technical-solution-review",
              "technical-solution-revise"
            ],
            "maxReviewCycles": 3,
            "completionPolicy": "first-cycle"
          }
        },
        "taskLoop": {
          "$ref": "#/$defs/automationProcessTaskLoop",
          "default": {
            "stageId": "task-delivery-loop",
            "implementationRouteKey": "task-implementation",
            "codeReviewRouteKey": "task-code-review",
            "maxReviewCycles": 3
          }
        }
      },
      "default": {
        "stageDefinitions": [],
        "draftReviewLoop": {
          "enabled": true,
          "routeSequence": ["draft-review", "draft-review-verify"],
          "maxReviewCycles": 2,
          "completionPolicy": "first-cycle"
        },
        "solutionReviewLoop": {
          "enabled": true,
          "routeSequence": [
            "technical-solution",
            "technical-solution-review",
            "technical-solution-revise"
          ],
          "maxReviewCycles": 3,
          "completionPolicy": "first-cycle"
        },
        "taskLoop": {
          "stageId": "task-delivery-loop",
          "implementationRouteKey": "task-implementation",
          "codeReviewRouteKey": "task-code-review",
          "maxReviewCycles": 3
        }
      }
    },
    "automationAudit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "logPrompts": {
          "type": "boolean",
          "default": false
        },
        "logCommands": {
          "type": "boolean",
          "default": true
        },
        "outputDir": {
          "$ref": "./shared.schema.json#/$defs/relativePath",
          "default": ".repo-ai-governor/reports/runs"
        },
        "latestFileName": {
          "$ref": "./shared.schema.json#/$defs/nonEmptyString",
          "default": "latest-run.json"
        }
      },
      "default": {
        "enabled": true,
        "logPrompts": false,
        "logCommands": true,
        "outputDir": ".repo-ai-governor/reports/runs",
        "latestFileName": "latest-run.json"
      }
    },
    "automationConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["manual", "assisted", "autonomous"],
          "default": "assisted"
        },
        "defaultSurface": {
          "$ref": "#/$defs/automationSurfaceId",
          "default": "codex"
        },
        "routingProfile": {
          "$ref": "./shared.schema.json#/$defs/nonEmptyString",
          "default": "multi-ai-dev-review"
        },
        "routing": {
          "$ref": "#/$defs/automationStageRouting",
          "default": {}
        },
        "profiles": {
          "type": "object",
          "propertyNames": {
            "$ref": "./shared.schema.json#/$defs/slug"
          },
          "additionalProperties": {
            "$ref": "#/$defs/automationRoutingProfile"
          },
          "default": {}
        },
        "preflight": {
          "$ref": "#/$defs/automationPreflight",
          "default": {
            "enabled": true,
            "failOnMissingRequiredSurface": true
          }
        },
        "surfaces": {
          "$ref": "#/$defs/automationSurfaces",
          "default": {}
        },
        "taskLoop": {
          "$ref": "#/$defs/automationTaskLoop",
          "default": {
            "maxReviewCycles": 3,
            "completionStatuses": ["done", "resolved", "completed", "closed"]
          }
        },
        "process": {
          "$ref": "#/$defs/automationProcess",
          "default": {
            "stageDefinitions": [],
            "draftReviewLoop": {
              "enabled": true,
              "routeSequence": ["draft-review", "draft-review-verify"],
              "maxReviewCycles": 2,
              "completionPolicy": "first-cycle"
            },
            "solutionReviewLoop": {
              "enabled": true,
              "routeSequence": [
                "technical-solution",
                "technical-solution-review",
                "technical-solution-revise"
              ],
              "maxReviewCycles": 3,
              "completionPolicy": "first-cycle"
            },
            "taskLoop": {
              "stageId": "task-delivery-loop",
              "implementationRouteKey": "task-implementation",
              "codeReviewRouteKey": "task-code-review",
              "maxReviewCycles": 3
            }
          }
        },
        "permissions": {
          "$ref": "#/$defs/automationPermissions",
          "default": {
            "allowRead": true,
            "allowEditCode": true,
            "allowEditDocs": true,
            "allowRunChecks": true,
            "allowCommit": true,
            "allowPush": true,
            "allowPullRequest": true,
            "allowSecretsEdit": false,
            "allowInfraEdit": false,
            "allowProductionConfigEdit": false,
            "allowDangerousCommands": false
          }
        },
        "gates": {
          "$ref": "#/$defs/automationGates",
          "default": {
            "requireApprovalFor": []
          }
        },
        "audit": {
          "$ref": "#/$defs/automationAudit",
          "default": {
            "enabled": true,
            "logPrompts": false,
            "logCommands": true,
            "outputDir": ".repo-ai-governor/reports/runs",
            "latestFileName": "latest-run.json"
          }
        }
      }
    },
    "ciConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "commandProfile": {
          "type": "string",
          "default": "default"
        },
        "failOn": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["errors", "warnings"]
          },
          "uniqueItems": true,
          "default": ["errors"]
        },
        "writeJsonReport": {
          "type": "boolean",
          "default": true
        },
        "writeMarkdownReport": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "reportingFileNames": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string",
          "default": "latest.txt"
        },
        "markdown": {
          "type": "string",
          "default": "latest.md"
        },
        "json": {
          "type": "string",
          "default": "latest.json"
        }
      }
    },
    "reportingConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "outputDir": {
          "$ref": "./shared.schema.json#/$defs/relativePath",
          "default": ".repo-ai-governor/reports"
        },
        "formats": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["summary", "markdown", "json"]
          },
          "uniqueItems": true,
          "default": ["summary", "markdown", "json"]
        },
        "overwrite": {
          "type": "boolean",
          "default": false
        },
        "includeSummary": {
          "type": "boolean",
          "default": true
        },
        "fileNames": {
          "$ref": "#/$defs/reportingFileNames",
          "default": {
            "summary": "latest.txt",
            "markdown": "latest.md",
            "json": "latest.json"
          }
        }
      }
    },
    "artifactFiles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "index": {
          "type": "string",
          "default": "index.md"
        },
        "plan": {
          "type": "string",
          "default": "plan.md"
        }
      }
    },
    "artifactDirectories": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tasks": {
          "type": "string",
          "default": "tasks"
        },
        "codeReview": {
          "type": "string",
          "default": "code-review"
        }
      }
    },
    "artifactTaskFiles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "checklist": {
          "type": "string",
          "default": "checklist.md"
        },
        "csv": {
          "type": "string",
          "default": "tasks.csv"
        },
        "csvColumns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "default": [
            "execution_id",
            "task_id",
            "title",
            "owner",
            "priority",
            "due_date",
            "status",
            "project",
            "sprint",
            "plan",
            "result",
            "verify",
            "review_delta",
            "recorded_at"
          ]
        }
      }
    },
    "artifactReviewFiles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pending": {
          "$ref": "./shared.schema.json#/$defs/reviewFileTemplate",
          "default": "review_<slug>.md"
        },
        "verified": {
          "$ref": "./shared.schema.json#/$defs/reviewFileTemplate",
          "default": "verified_review_<slug>.md"
        },
        "resolved": {
          "$ref": "./shared.schema.json#/$defs/reviewFileTemplate",
          "default": "resolved_review_<slug>.md"
        }
      }
    },
    "artifactsConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "baseDir": {
          "type": "string",
          "default": "docs"
        },
        "structure": {
          "type": "string",
          "enum": ["project-sprint"],
          "default": "project-sprint"
        },
        "files": {
          "$ref": "#/$defs/artifactFiles",
          "default": {
            "index": "index.md",
            "plan": "plan.md"
          }
        },
        "directories": {
          "$ref": "#/$defs/artifactDirectories",
          "default": {
            "tasks": "tasks",
            "codeReview": "code-review"
          }
        },
        "taskFiles": {
          "$ref": "#/$defs/artifactTaskFiles",
          "default": {
            "checklist": "checklist.md",
            "csv": "tasks.csv",
            "csvColumns": [
              "execution_id",
              "task_id",
              "title",
              "owner",
              "priority",
              "due_date",
              "status",
              "project",
              "sprint",
              "plan",
              "result",
              "verify",
              "review_delta",
              "recorded_at"
            ]
          }
        },
        "reviewFiles": {
          "$ref": "#/$defs/artifactReviewFiles",
          "default": {
            "pending": "review_<slug>.md",
            "verified": "verified_review_<slug>.md",
            "resolved": "resolved_review_<slug>.md"
          }
        }
      }
    },
    "agentEntryConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target": {
          "$ref": "./shared.schema.json#/$defs/relativePath",
          "default": "AGENTS.md"
        },
        "contextFile": {
          "$ref": "./shared.schema.json#/$defs/relativePath",
          "default": ".repo-ai-governor/context/current-context.md"
        },
        "mode": {
          "type": "string",
          "enum": ["generated-from-structured-config", "manual-sync"],
          "default": "generated-from-structured-config"
        },
        "includeSections": {
          "$ref": "./shared.schema.json#/$defs/stringList",
          "default": [
            "current-context",
            "source-of-truth",
            "working-rules",
            "naming-rules",
            "default-workflow",
            "local-skills"
          ]
        }
      }
    }
  }
}
