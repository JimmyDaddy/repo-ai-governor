{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repo-ai-governor.dev/schemas/v1/slot.schema.json",
  "title": "Repo AI Governor Slot Schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "kind"],
  "properties": {
    "id": {
      "$ref": "./shared.schema.json#/$defs/slotId"
    },
    "version": {
      "type": "string",
      "const": "1"
    },
    "kind": {
      "type": "string",
      "const": "governance-slot"
    },
    "meta": {
      "$ref": "#/$defs/metaConfig",
      "default": {
        "source": "project-local",
        "slotType": "custom",
        "tags": []
      }
    },
    "trigger": {
      "$ref": "#/$defs/triggerConfig",
      "default": {
        "match": "any",
        "when": {
          "paths": [],
          "stages": [],
          "events": [],
          "adapters": [],
          "commands": []
        }
      }
    },
    "scope": {
      "$ref": "#/$defs/scopeConfig",
      "default": {
        "languages": [],
        "frameworks": [],
        "projects": [],
        "files": [],
        "tags": []
      }
    },
    "behavior": {
      "$ref": "#/$defs/behaviorConfig",
      "default": {
        "blockOnFailure": true,
        "priority": 100,
        "requiresApproval": false,
        "conflictPolicy": "error",
        "dependsOn": [],
        "supersedes": [],
        "inject": {}
      }
    },
    "checks": {
      "$ref": "#/$defs/checksConfig",
      "default": {
        "before": [],
        "after": []
      }
    },
    "extensions": {
      "$ref": "#/$defs/extensionsConfig",
      "default": {
        "scripts": []
      }
    }
  },
  "$defs": {
    "metaConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "./shared.schema.json#/$defs/localizedText"
        },
        "source": {
          "type": "string",
          "enum": ["project-local", "team-shared", "official"],
          "default": "project-local"
        },
        "slotType": {
          "type": "string",
          "enum": [
            "architecture-constraint",
            "security-compliance",
            "domain-knowledge",
            "test-strategy",
            "release-approval",
            "documentation-output",
            "custom"
          ],
          "default": "custom"
        },
        "owner": {
          "$ref": "./shared.schema.json#/$defs/nonEmptyString"
        },
        "description": {
          "$ref": "./shared.schema.json#/$defs/localizedText"
        },
        "tags": {
          "$ref": "./shared.schema.json#/$defs/slugList",
          "default": []
        }
      }
    },
    "triggerWhenConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "paths": {
          "$ref": "./shared.schema.json#/$defs/stringList",
          "default": []
        },
        "stages": {
          "$ref": "./shared.schema.json#/$defs/stageList",
          "default": []
        },
        "events": {
          "$ref": "./shared.schema.json#/$defs/stringList",
          "default": []
        },
        "adapters": {
          "$ref": "./shared.schema.json#/$defs/stringList",
          "default": []
        },
        "commands": {
          "$ref": "./shared.schema.json#/$defs/stringList",
          "default": []
        }
      }
    },
    "triggerConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "match": {
          "type": "string",
          "enum": ["any", "all"],
          "default": "any"
        },
        "when": {
          "$ref": "#/$defs/triggerWhenConfig",
          "default": {
            "paths": [],
            "stages": [],
            "events": [],
            "adapters": [],
            "commands": []
          }
        }
      }
    },
    "scopeConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "languages": {
          "$ref": "./shared.schema.json#/$defs/stringList",
          "default": []
        },
        "frameworks": {
          "$ref": "./shared.schema.json#/$defs/stringList",
          "default": []
        },
        "projects": {
          "type": "array",
          "items": {
            "$ref": "./shared.schema.json#/$defs/projectSlug"
          },
          "uniqueItems": true,
          "default": []
        },
        "files": {
          "$ref": "./shared.schema.json#/$defs/stringList",
          "default": []
        },
        "tags": {
          "$ref": "./shared.schema.json#/$defs/stringList",
          "default": []
        }
      }
    },
    "injectConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ai": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "promptKey": {
              "$ref": "./shared.schema.json#/$defs/nonEmptyString"
            }
          }
        },
        "human": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "docSection": {
              "$ref": "./shared.schema.json#/$defs/nonEmptyString"
            }
          }
        }
      }
    },
    "behaviorConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "blockOnFailure": {
          "type": "boolean",
          "default": true
        },
        "priority": {
          "type": "integer",
          "default": 100
        },
        "requiresApproval": {
          "type": "boolean",
          "default": false
        },
        "conflictPolicy": {
          "type": "string",
          "enum": ["error", "override", "merge"],
          "default": "error"
        },
        "dependsOn": {
          "$ref": "./shared.schema.json#/$defs/slugList",
          "default": []
        },
        "supersedes": {
          "$ref": "./shared.schema.json#/$defs/slugList",
          "default": []
        },
        "inject": {
          "$ref": "#/$defs/injectConfig",
          "default": {}
        }
      }
    },
    "checksConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "before": {
          "$ref": "./shared.schema.json#/$defs/stringList",
          "default": []
        },
        "after": {
          "$ref": "./shared.schema.json#/$defs/stringList",
          "default": []
        }
      }
    },
    "scriptExtensionRuntimeConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "entry"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["command", "node-module"]
        },
        "entry": {
          "$ref": "./shared.schema.json#/$defs/nonEmptyString"
        },
        "args": {
          "$ref": "./shared.schema.json#/$defs/stringList",
          "default": []
        },
        "cwd": {
          "$ref": "./shared.schema.json#/$defs/relativePath"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1000,
          "default": 30000
        }
      }
    },
    "scriptExtensionFilesystemPermissionsConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "read": {
          "$ref": "./shared.schema.json#/$defs/stringList",
          "default": []
        },
        "write": {
          "$ref": "./shared.schema.json#/$defs/stringList",
          "default": []
        }
      }
    },
    "scriptExtensionPermissionsConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "filesystem": {
          "$ref": "#/$defs/scriptExtensionFilesystemPermissionsConfig",
          "default": {
            "read": [],
            "write": []
          }
        },
        "network": {
          "type": "string",
          "enum": ["forbid", "allow"],
          "default": "forbid"
        },
        "git": {
          "type": "string",
          "enum": ["forbid", "read", "write"],
          "default": "forbid"
        },
        "secrets": {
          "type": "string",
          "enum": ["forbid", "allow-inherited"],
          "default": "forbid"
        }
      }
    },
    "scriptExtensionAuditConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "logKey": {
          "$ref": "./shared.schema.json#/$defs/nonEmptyString"
        },
        "capture": {
          "$ref": "./shared.schema.json#/$defs/stringList",
          "default": ["exitCode", "stdout", "stderr"]
        },
        "redact": {
          "$ref": "./shared.schema.json#/$defs/stringList",
          "default": []
        }
      }
    },
    "scriptExtensionIsolationConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["process", "external-runner"],
          "default": "process"
        }
      }
    },
    "scriptExtensionConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "runtime"],
      "properties": {
        "id": {
          "$ref": "./shared.schema.json#/$defs/slug"
        },
        "description": {
          "$ref": "./shared.schema.json#/$defs/localizedText"
        },
        "hook": {
          "type": "string",
          "enum": ["before", "after"],
          "default": "after"
        },
        "failurePolicy": {
          "$ref": "./shared.schema.json#/$defs/failurePolicy",
          "default": "stop"
        },
        "runtime": {
          "$ref": "#/$defs/scriptExtensionRuntimeConfig"
        },
        "permissions": {
          "$ref": "#/$defs/scriptExtensionPermissionsConfig",
          "default": {
            "filesystem": {
              "read": [],
              "write": []
            },
            "network": "forbid",
            "git": "forbid",
            "secrets": "forbid"
          }
        },
        "audit": {
          "$ref": "#/$defs/scriptExtensionAuditConfig",
          "default": {
            "capture": ["exitCode", "stdout", "stderr"],
            "redact": []
          }
        },
        "isolation": {
          "$ref": "#/$defs/scriptExtensionIsolationConfig",
          "default": {
            "mode": "process"
          }
        }
      }
    },
    "extensionsConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scripts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scriptExtensionConfig"
          },
          "default": []
        }
      }
    }
  }
}
