{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "//#gate:format": {
      "cache": false,
      "outputs": []
    },
    "//#gate:lint": {
      "cache": false,
      "dependsOn": ["//#gate:format"],
      "outputs": []
    },
    "//#gate:build": {
      "cache": false,
      "dependsOn": ["//#gate:lint"],
      "outputs": []
    },
    "//#gate:code-standards": {
      "cache": false,
      "dependsOn": ["//#gate:build"],
      "outputs": []
    },
    "//#gate:docs-triad-sync": {
      "cache": false,
      "dependsOn": ["//#gate:build"],
      "outputs": []
    },
    "//#gate:finite-literal-sets": {
      "cache": false,
      "dependsOn": ["//#gate:build"],
      "outputs": []
    },
    "//#gate:dependency-boundary": {
      "cache": false,
      "dependsOn": ["//#gate:build"],
      "outputs": []
    },
    "//#gate:standardized-errors": {
      "cache": false,
      "dependsOn": ["//#gate:build"],
      "outputs": []
    },
    "//#gate:artifact-lifecycle": {
      "cache": false,
      "dependsOn": ["//#gate:build"],
      "outputs": []
    },
    "//#gate:examples-smoke": {
      "cache": false,
      "dependsOn": ["//#gate:build"],
      "outputs": []
    },
    "//#gate:examples-runtime-smoke": {
      "cache": false,
      "dependsOn": ["//#gate:build"],
      "outputs": []
    },
    "//#gate:normative-loading-manifest": {
      "cache": false,
      "dependsOn": ["//#gate:build"],
      "outputs": []
    },
    "//#gate:stage9-handoff": {
      "cache": false,
      "dependsOn": ["//#gate:build"],
      "outputs": []
    },
    "//#gate:task-ledger-sync": {
      "cache": false,
      "dependsOn": ["//#gate:build"],
      "outputs": []
    },
    "//#gate:sprint-plan-status-sync": {
      "cache": false,
      "dependsOn": ["//#gate:build"],
      "outputs": []
    },
    "//#gate:code-review-status-sync": {
      "cache": false,
      "dependsOn": ["//#gate:build"],
      "outputs": []
    },
    "//#gate:worktree-review-target": {
      "cache": false,
      "dependsOn": ["//#gate:build"],
      "outputs": []
    },
    "//#gate:i18n-parity-fallback": {
      "cache": false,
      "dependsOn": ["//#gate:build"],
      "outputs": []
    },
    "//#gate:test:packages": {
      "cache": false,
      "dependsOn": ["//#gate:build"],
      "outputs": []
    },
    "//#gate:test:contract": {
      "cache": false,
      "dependsOn": ["//#gate:build"],
      "outputs": []
    },
    "//#gate:test:integration": {
      "cache": false,
      "dependsOn": ["//#gate:test:packages", "//#gate:test:contract"],
      "outputs": []
    },
    "//#gate:test:e2e": {
      "cache": false,
      "dependsOn": ["//#gate:test:integration"],
      "outputs": []
    },
    "//#gate:test:resilience": {
      "cache": false,
      "dependsOn": ["//#gate:build"],
      "outputs": []
    },
    "//#gate:check": {
      "cache": false,
      "dependsOn": [
        "//#gate:code-standards",
        "//#gate:docs-triad-sync",
        "//#gate:finite-literal-sets",
        "//#gate:dependency-boundary",
        "//#gate:standardized-errors",
        "//#gate:artifact-lifecycle",
        "//#gate:examples-smoke",
        "//#gate:examples-runtime-smoke",
        "//#gate:normative-loading-manifest",
        "//#gate:stage9-handoff",
        "//#gate:task-ledger-sync",
        "//#gate:sprint-plan-status-sync",
        "//#gate:code-review-status-sync",
        "//#gate:worktree-review-target",
        "//#gate:i18n-parity-fallback",
        "//#gate:test:contract",
        "//#gate:test:packages",
        "//#gate:test:integration",
        "//#gate:test:e2e",
        "//#gate:test:resilience"
      ],
      "outputs": []
    }
  }
}
